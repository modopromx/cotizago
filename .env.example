# CotizaGo — copia este archivo como .env y rellena los valores.
# Todo lo que empieza con VITE_ queda DENTRO del bundle público:
# cualquiera que abra la app puede leerlo. Nunca pongas secretos aquí.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=

# La anon key es pública por diseño y no es un secreto: lo que protege los
# datos son las políticas RLS de supabase/migrations/0003_rls.sql.

# VITE_ADMIN_EMAILS ya no se usa. El rol de admin vive en profiles.is_admin,
# porque una lista de emails en el bundle es visible y no protege nada.

# ---------------------------------------------------------------
# NO van aquí — se configuran como secrets de Edge Function en Supabase:
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_...
#   supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
#   supabase secrets set RESEND_API_KEY=re_...
# ---------------------------------------------------------------
