# CotizaGo — routing SPA en Hostinger (Apache / LiteSpeed)
# Sin esto, recargar /app/clientes devuelve 404: Apache busca un archivo que no
# existe. React Router necesita que todas las rutas lleguen a index.html.

Options -MultiViews
RewriteEngine On

# Archivos y carpetas reales se sirven tal cual
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Todo lo demás lo resuelve React Router
RewriteRule ^ index.html [QSA,L]

# ---------------------------------------------------------------------------
# Caché
# Los assets de /assets/ llevan hash en el nombre: cambian de nombre en cada
# despliegue, así que pueden cachearse para siempre sin riesgo.
# NO pasa lo mismo con index.html, sw.js, registerSW.js ni el manifiesto: esos
# conservan el mismo nombre entre versiones. Si se cachean, el navegador se
# queda con la versión vieja y el usuario nunca recibe una actualización.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(js|css|woff2|png|jpg|jpeg|svg|webp|ico)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  <FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest)$">
    ExpiresDefault "access plus 0 seconds"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2|png|jpg|jpeg|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # El service worker solo puede controlar su propio directorio hacia abajo.
  # Estando en la raíz esto no hace falta, pero deja el ámbito explícito.
  <Files "sw.js">
    Header set Service-Worker-Allowed "/"
  </Files>
</IfModule>

# El manifiesto necesita su tipo MIME correcto o algunos navegadores lo ignoran.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/manifest+json
</IfModule>
