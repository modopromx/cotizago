# CotizaGo — routing SPA en Hostinger (Apache / LiteSpeed)
# Sin esto, recargar /app/clientes devuelve 404: Apache busca un archivo que no
# existe. React Router necesita que todas las rutas lleguen a index.html.

Options -MultiViews
RewriteEngine On

# Archivos y carpetas reales se sirven tal cual
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Todo lo demás lo resuelve React Router
RewriteRule ^ index.html [QSA,L]

# Los assets con hash en el nombre pueden cachearse para siempre
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(js|css|woff2|png|jpg|jpeg|svg|webp)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  # index.html nunca se cachea, o los usuarios se quedan con la versión vieja
  <FilesMatch "index\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
